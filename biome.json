{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "files": {
    "includes": [
      "**",
      "!node_modules",
      "!mcp",
      "!.next",
      "!.open-next",
      "!.cloudflare",
      "!.wrangler",
      "!build",
      "!out",
      "!coverage",
      "!next-env.d.ts",
      "!test-results",
      "!playwright-report"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noImportantStyles": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "off"
      }
    }
  }
}
