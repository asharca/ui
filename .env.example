# Optional server-only crawler collection; never use NEXT_PUBLIC_ for this key.
TRACWELL_SERVER_KEY=

# Set your real Next.js site origin in the build environment when deploying.
# Workspace URLs in llms.txt fall back to localhost when unset; they do not
# automatically follow the request host. Rebuild after changing this value.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
