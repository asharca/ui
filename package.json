{
  "name": "asharca-ui-site",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": { "node": ">=22.14" },
  "scripts": {
    "dev": "node scripts/build-registry.mjs && vite --host 0.0.0.0",
    "registry": "node scripts/build-registry.mjs",
    "build": "pnpm registry && tsc --noEmit && vite build && node scripts/static-routes.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run && node --test tests/registry.test.mjs",
    "test:browser": "playwright test",
    "test:consumer": "node scripts/check-consumer.mjs",
    "check": "pnpm registry && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.21.0",
    "motion": "^12.0.0",
    "prismjs": "1.30.0",
    "radix-ui": "1.6.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "^7.0.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "jsdom": "^29.1.1",
    "shadcn": "4.21.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.9"
  }
}
