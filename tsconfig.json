{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "noEmit": true,
    "allowJs": true, "checkJs": false, "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true, "esModuleInterop": true,
    "baseUrl": ".", "paths": { "@/components/asharca/*": ["registry/ui/*"] },
    "types": ["vite/client", "node", "@testing-library/jest-dom"]
  },
  "include": ["site", "registry", "examples", "tests/**/*.tsx", "tests/setup.ts", "vite.config.ts", "playwright.config.ts"],
  "exclude": ["node_modules", "dist", ".consumer"]
}
